# Conexión a base de datos. SQLite para desarrollo local, PostgreSQL en Docker/producción.

POSTGRES_USER=usuario_ejemplo
POSTGRES_PASSWORD=password_seguro_ejemplo
POSTGRES_DB=solaris_monitoring_base_ejemplo

DATABASE_URL=sqlite:///./solaris_monitoring.db

ENVIRONMENT=development
API_TITLE=Solaris Monitoring - Photovoltaic Monitor
API_VERSION=1.0.0

# Clave API para autenticar dispositivos en escritura (lecturas y cambios de celdas)
DEVICE_API_KEY=desarrollo_api_key_ejemplo_sin_usar

# MQTT (opcional). Sin MQTT_HOST la API arranca sin suscriptor y recibe lecturas solo por HTTP.
# MQTT_HOST=tu-broker.s1.eu.hivemq.cloud
# MQTT_PORT=8883
# MQTT_USERNAME=usuario_ejemplo
# MQTT_PASSWORD=password_ejemplo
# MQTT_TOPIC=solaris/edsia_beyond/cell_1/voltage